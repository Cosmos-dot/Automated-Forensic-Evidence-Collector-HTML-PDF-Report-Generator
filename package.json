{
  "name": "forensic-collector",
  "version": "1.0.0",
  "description": "Automated Standalone Windows DFIR Evidence Collector & Report Generator",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "pkg . --targets node18-win-x64 --output dist/forensic-collector.exe"
  },
  "pkg": {
    "assets": [
      "src/templates/**/*",
      "templates/**/*"
    ],
    "outputPath": "dist"
  },
  "keywords": [
    "dfir",
    "forensics",
    "evidence-collector",
    "incident-response",
    "windows"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ejs": "^3.1.9",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
